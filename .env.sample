# Sample environment. Copy to .env and adjust (never commit .env):
#   cp .env.sample .env
# Local dev works without any of these (all have safe defaults).

# --- Backend (Django) ---
# Prod secret; dev default is insecure and for local use only.
DJANGO_SECRET_KEY=dev-only-insecure-key
# 1 = debug/dev server, 0 in prod.
DJANGO_DEBUG=1
# Comma-separated; "*" is dev default, set real hosts in prod.
DJANGO_ALLOWED_HOSTS=*
# 1 = allow all CORS origins (dev default); 0 in prod behind a fixed frontend.
DJANGO_CORS_ALLOW_ALL=1

# External providers (all free, no keys). Override to self-host or swap vendors.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Required by Nominatim usage policy; identify your deployment.
NOMINATIM_USER_AGENT=weather-truck-routing/1.0

# --- Frontend (Vite) ---
# Empty = use the dev proxy (/api -> localhost:8000). In prod builds point at the API host.
VITE_API_BASE=
